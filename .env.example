# Vercel → Project → Settings → Environment Variables
# Formlar Resend ile e-posta gönderir (https://resend.com, ücretsiz katman yeter).
RESEND_API_KEY=re_xxxxxxxx
# Form e-postalarının gideceği adres
CONTACT_TO_EMAIL=senin@adresin.com
# Gönderen. Kendi alan adını Resend'de doğrulayana kadar onboarding@resend.dev kullan
# (bu gönderici yalnızca Resend hesabının sahibine e-posta atabilir).
CONTACT_FROM_EMAIL=Auto Yard <onboarding@resend.dev>
# İsteğe bağlı: canonical/sitemap adresi. Boşsa Vercel'in üretim adresi kullanılır.
SITE_URL=
